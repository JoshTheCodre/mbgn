# Copy to .env. Everything is optional in development.

NODE_ENV=development
PORT=3000
# The address people use to reach the site. Goes into voting links, emails and Paystack redirects.
PUBLIC_URL=http://localhost:3000
# Required in production: a long random string (used to hash IP addresses for fraud checks).
APP_SECRET=
# Set to 1 behind Nginx, Render, Railway and similar, so rate limits see the real visitor IP.
TRUST_PROXY=0
# Required. A pooled Neon connection string, with sslmode=verify-full.
DATABASE_URL=
# Where photos go if the R2 settings below are blank. Not usable on Vercel.
DATA_DIR=./data

# Cloudflare R2, for contestant photos. Keep the bucket private.
# The keys come from the Cloudflare dashboard: R2 > Manage API Tokens, limited to this bucket.
R2_ACCOUNT_ID=
R2_BUCKET=mbgn-photos
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Contestant code prefix: MBG gives MBG001, MBG002... Fix this before the first approval.
CODE_PREFIX=MBG

# The first admin account, created on first start.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Paystack secret key: sk_test_... to test, sk_live_... in production. Server-side only.
# Leave blank to use the built-in payment simulator (refused when NODE_ENV=production).
PAYSTACK_SECRET_KEY=
# Required in production. Paystack needs a customer email and supporters aren't asked for one,
# so each payment uses this mailbox with its reference added: votes+mbg-123@yourdomain.com.
PAYMENT_EMAIL=votes@yourdomain.com

# Email. Leave blank to only record messages in the admin email log.
# Example: smtps://user:password@smtp.example.com:465
SMTP_URL=
MAIL_FROM=MBGN <no-reply@yourdomain.com>
