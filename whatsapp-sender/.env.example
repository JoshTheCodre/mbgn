# Copy this file to .env and fill it in. Never commit .env.

# The live site.
SITE_URL=https://www.mbgn.com.ng

# A long random secret. Set the exact same value on Vercel as WHATSAPP_SENDER_TOKEN.
# Make one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
WHATSAPP_SENDER_TOKEN=

# How to reach WhatsApp: baileys (built in), evolution (an Evolution API server you run),
# or dry-run (prints messages; only against a copy of the site on this computer).
TRANSPORT=baileys

# --- Baileys ---
# Where the WhatsApp login is saved after the first scan. Keep it private: it is the login.
AUTH_DIR=auth
# Optional: the contest number (e.g. 2348012345678) to link with an 8-character pairing code
# instead of scanning a QR code. Handy on a server with no screen.
PAIRING_NUMBER=

# --- Evolution API (v2) ---
EVOLUTION_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# Pace. Seconds between messages, and between checks when there is nothing to send.
SEND_GAP_SECONDS=6
POLL_SECONDS=15
